# Admin authentication
# Login: dominique@pensato.org
ADMIN_EMAIL=dominique@pensato.org
ADMIN_PASSWORD=P@n@sonic1

# Session secret (32+ random chars). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-with-long-random-string-min-32-chars

# Salt for hashing IP addresses (GDPR). Generate: openssl rand -hex 32
IP_HASH_SALT=change-me-with-long-random-string-min-32-chars

# E-mail notifications (Resend) — currently DISABLED
EMAIL_ENABLED=false
RESEND_API_KEY=re_your_key_here_when_ready
NOTIFY_FROM=survey@andredevaere.org
NOTIFY_TO=dominique.dejonghe@iutum.be

# OpenAI API key for AI-driven survey analysis (gpt-4o-mini, ~€0,002 per analysis)
# Generate at: https://platform.openai.com/api-keys
# If empty, the system falls back to Cloudflare Workers AI (Llama 3.3, free but slow ~90s)
OPENAI_API_KEY=sk-proj-your-key-here
